{
  "name": "@veksa/reselect-utils",
  "version": "5.1.0-p15",
  "packageManager": "yarn@4.9.2",
  "main": "./dist/cjs/index.js",
  "types": "./dist/reselectUtils.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/reselectUtils.d.ts",
      "import": "./dist/reselectUtils.mjs",
      "default": "./dist/cjs/index.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "yarn clean && tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc --noEmit -p _type-tests/tsconfig.json",
    "lint": "eslint src/",
    "compile": "tsc --noEmit",
    "clean": "rimraf lib es dist"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx}": [
      "yarn lint --cache --fix",
      "vitest related --run --bail=1"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@veksa/re-reselect": "^5.1.1-p8",
    "@veksa/react-redux": "^9.2.0-p7",
    "@veksa/reselect": "^5.1.1-p7",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^8.0.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "expect-type": "^1.2.1",
    "jsdom": "^30.0.0",
    "lint-staged": "^15.2.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@veksa/re-reselect": "^5.1.1-p8",
    "@veksa/react-redux": "^9.2.0-p7",
    "@veksa/reselect": "^5.1.1-p7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
