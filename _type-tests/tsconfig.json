{
  "compilerOptions": {
    "jsx": "react",
    "target": "es2015",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["dom", "es2020"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "importHelpers": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["**/*.ts"]
}
